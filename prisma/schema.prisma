// Esquema Prisma equivalente a db/migraciones/*.sql (PostgreSQL); al cambiar una
// migracion, actualiza tambien este archivo.
// Los CHECK de la base de datos no se pueden expresar en Prisma, por eso los
// "enums" se mantienen como String y se validan en la capa de dominio/DTOs.
// NO ejecutar `prisma migrate` sobre este esquema: la base se gestiona con npm run db:migrar.
// Solo se necesita `prisma generate` (se ejecuta solo con npm install).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                 BigInt   @id @default(autoincrement()) @map("id_usuario")
  nombreCompleto     String   @map("nombre_completo") @db.VarChar(150)
  correo             String   @unique @db.VarChar(254)
  passwordHash       String   @map("password_hash")
  telefono           String?  @db.VarChar(25)
  telefonoVerificado Boolean  @default(false) @map("telefono_verificado")
  rol                String   @default("CLIENTE") @db.VarChar(20)
  estadoCuenta       String   @default("ACTIVA") @map("estado_cuenta") @db.VarChar(20)
  fechaRegistro      DateTime @default(now()) @map("fecha_registro") @db.Timestamptz(6)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)

  cliente        Cliente?
  vendedor       Vendedor?
  sesiones       Sesion[]
  solicitudes    SolicitudCambioRol[]
  notificaciones Notificacion[]

  @@map("usuarios")
}

model Cliente {
  id        BigInt @id @default(autoincrement()) @map("id_cliente")
  idUsuario BigInt @unique @map("id_usuario")

  usuario       Usuario       @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  favoritos     Favorito[]
  comparaciones Comparacion[]

  @@map("clientes")
}

model Vendedor {
  id                 BigInt  @id @default(autoincrement()) @map("id_vendedor")
  idUsuario          BigInt  @unique @map("id_usuario")
  dui                String? @unique @db.VarChar(10)
  numeroWhatsapp     String? @map("numero_whatsapp") @db.VarChar(25)
  estadoVerificacion String  @default("PENDIENTE") @map("estado_verificacion") @db.VarChar(20)

  usuario       Usuario                  @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  publicaciones Publicacion[]
  documentos    DocumentoVerificacion[]

  @@map("vendedores")
}

model Sesion {
  id                BigInt    @id @default(autoincrement()) @map("id_sesion")
  idUsuario         BigInt    @map("id_usuario")
  tokenHash         String    @unique @map("token_hash")
  fechaInicio       DateTime  @default(now()) @map("fecha_inicio") @db.Timestamptz(6)
  fechaExpiracion   DateTime  @map("fecha_expiracion") @db.Timestamptz(6)
  fechaFinalizacion DateTime? @map("fecha_finalizacion") @db.Timestamptz(6)
  activa            Boolean   @default(true)

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@map("sesiones")
}

model SolicitudCambioRol {
  id                   BigInt    @id @default(autoincrement()) @map("id_solicitud")
  idUsuario            BigInt    @map("id_usuario")
  fechaSolicitud       DateTime  @default(now()) @map("fecha_solicitud") @db.Timestamptz(6)
  estado               String    @default("PENDIENTE") @db.VarChar(20)
  requisitosPendientes String?   @map("requisitos_pendientes")
  fechaResolucion      DateTime? @map("fecha_resolucion") @db.Timestamptz(6)
  observaciones        String?

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@map("solicitudes_cambio_rol")
}

model DocumentoVerificacion {
  id             BigInt    @id @default(autoincrement()) @map("id_documento")
  idVendedor     BigInt    @map("id_vendedor")
  tipoDocumento  String    @map("tipo_documento") @db.VarChar(50)
  rutaDocumento  String    @map("ruta_documento")
  fechaEnvio     DateTime  @default(now()) @map("fecha_envio") @db.Timestamptz(6)
  estadoRevision String    @default("PENDIENTE") @map("estado_revision") @db.VarChar(20)
  observaciones  String?
  fechaRevision  DateTime? @map("fecha_revision") @db.Timestamptz(6)

  vendedor Vendedor @relation(fields: [idVendedor], references: [id], onDelete: Cascade)

  @@map("documentos_verificacion")
}

model Publicacion {
  id                 BigInt   @id @default(autoincrement()) @map("id_publicacion")
  idVendedor         BigInt   @map("id_vendedor")
  titulo             String   @db.VarChar(180)
  descripcion        String
  tipoOperacion      String   @default("VENTA") @map("tipo_operacion") @db.VarChar(15)
  precio             Decimal  @db.Decimal(12, 2)
  estado             String   @default("PENDIENTE") @db.VarChar(15)
  fechaPublicacion   DateTime @default(now()) @map("fecha_publicacion") @db.Timestamptz(6)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)

  vendedor       Vendedor              @relation(fields: [idVendedor], references: [id], onDelete: Restrict)
  terreno        Terreno?
  fotografias    Fotografia[]
  favoritos      Favorito[]
  historial      HistorialPrecio[]
  notificaciones Notificacion[]
  comparaciones  DetalleComparacion[]

  @@map("publicaciones")
}

model Terreno {
  id              BigInt  @id @default(autoincrement()) @map("id_terreno")
  idPublicacion   BigInt  @unique @map("id_publicacion")
  areaM2          Decimal @map("area_m2") @db.Decimal(14, 2)
  largoM          Decimal? @map("largo_m") @db.Decimal(12, 2)
  anchoM          Decimal? @map("ancho_m") @db.Decimal(12, 2)
  tipoTerreno     String? @map("tipo_terreno") @db.VarChar(80)
  caracteristicas String?

  publicacion Publicacion @relation(fields: [idPublicacion], references: [id], onDelete: Cascade)
  ubicacion   Ubicacion?

  @@map("terrenos")
}

model Ubicacion {
  id               BigInt   @id @default(autoincrement()) @map("id_ubicacion")
  idTerreno        BigInt   @unique @map("id_terreno")
  departamento     String   @db.VarChar(100)
  municipio        String   @db.VarChar(100)
  distrito         String?  @db.VarChar(100)
  direccionDetalle String?  @map("direccion_detalle")
  latitud          Decimal? @db.Decimal(10, 7)
  longitud         Decimal? @db.Decimal(10, 7)
  latitudPublica   Decimal? @map("latitud_publica") @db.Decimal(10, 7)
  longitudPublica  Decimal? @map("longitud_publica") @db.Decimal(10, 7)
  /// Columnas generadas por PostgreSQL (migracion 002); solo se consultan con $queryRaw.
  puntoPublico     Unsupported("geography(Point,4326)")? @map("punto_publico")
  puntoExacto      Unsupported("geography(Point,4326)")? @map("punto_exacto")

  terreno Terreno @relation(fields: [idTerreno], references: [id], onDelete: Cascade)

  @@map("ubicaciones")
}

model Fotografia {
  id            BigInt   @id @default(autoincrement()) @map("id_fotografia")
  idPublicacion BigInt   @map("id_publicacion")
  urlImagen     String   @map("url_imagen")
  descripcion   String?  @db.VarChar(250)
  orden         Int      @default(1)
  esPortada     Boolean  @default(false) @map("es_portada")
  fechaSubida   DateTime @default(now()) @map("fecha_subida") @db.Timestamptz(6)

  publicacion Publicacion @relation(fields: [idPublicacion], references: [id], onDelete: Cascade)

  @@unique([idPublicacion, orden])
  @@map("fotografias")
}

model Favorito {
  id              BigInt   @id @default(autoincrement()) @map("id_favorito")
  idCliente       BigInt   @map("id_cliente")
  idPublicacion   BigInt   @map("id_publicacion")
  fechaGuardado   DateTime @default(now()) @map("fecha_guardado") @db.Timestamptz(6)
  precioAlGuardar Decimal  @map("precio_al_guardar") @db.Decimal(12, 2)

  cliente     Cliente     @relation(fields: [idCliente], references: [id], onDelete: Cascade)
  publicacion Publicacion @relation(fields: [idPublicacion], references: [id], onDelete: Cascade)

  @@unique([idCliente, idPublicacion])
  @@index([idPublicacion], map: "idx_favoritos_publicacion")
  @@map("favoritos")
}

model HistorialPrecio {
  id             BigInt   @id @default(autoincrement()) @map("id_historial")
  idPublicacion  BigInt   @map("id_publicacion")
  precioAnterior Decimal  @map("precio_anterior") @db.Decimal(12, 2)
  precioNuevo    Decimal  @map("precio_nuevo") @db.Decimal(12, 2)
  fechaCambio    DateTime @default(now()) @map("fecha_cambio") @db.Timestamptz(6)

  publicacion    Publicacion    @relation(fields: [idPublicacion], references: [id], onDelete: Cascade)
  notificaciones Notificacion[]

  @@map("historial_precios")
}

model Notificacion {
  id            BigInt    @id @default(autoincrement()) @map("id_notificacion")
  idUsuario     BigInt    @map("id_usuario")
  idPublicacion BigInt?   @map("id_publicacion")
  titulo        String    @db.VarChar(150)
  mensaje       String
  tipo          String    @db.VarChar(40)
  fechaCreacion DateTime  @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  leida         Boolean   @default(false)
  fechaLectura  DateTime? @map("fecha_lectura") @db.Timestamptz(6)
  idHistorial   BigInt?   @map("id_historial")

  usuario     Usuario          @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  publicacion Publicacion?     @relation(fields: [idPublicacion], references: [id], onDelete: SetNull)
  historial   HistorialPrecio? @relation(fields: [idHistorial], references: [id], onDelete: SetNull)

  @@unique([idUsuario, idHistorial])
  @@map("notificaciones")
}

model Comparacion {
  id            BigInt   @id @default(autoincrement()) @map("id_comparacion")
  idCliente     BigInt   @map("id_cliente")
  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)

  cliente  Cliente              @relation(fields: [idCliente], references: [id], onDelete: Cascade)
  detalles DetalleComparacion[]

  @@map("comparaciones")
}

model DetalleComparacion {
  idComparacion BigInt @map("id_comparacion")
  idPublicacion BigInt @map("id_publicacion")

  comparacion Comparacion @relation(fields: [idComparacion], references: [id], onDelete: Cascade)
  publicacion Publicacion @relation(fields: [idPublicacion], references: [id], onDelete: Cascade)

  @@id([idComparacion, idPublicacion])
  @@map("detalle_comparacion")
}

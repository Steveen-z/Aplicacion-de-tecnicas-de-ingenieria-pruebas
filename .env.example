# ---- Base de datos ----
DATABASE_URL="postgresql://postgres:123@localhost:5432/plataforma_terrenos?schema=public"

# ---- Servidor ----
NODE_ENV=development
PORT=3000
# Orígenes permitidos del frontend, separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost:4200
# Poner en true si el backend está detrás de un proxy/balanceador (para rate limiting por IP real)
TRUST_PROXY=false
# URL pública del backend (se usa para construir las URLs de las imágenes subidas)
PUBLIC_BASE_URL=http://localhost:3000

# ---- Seguridad ----
# Mínimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
# Duración de la sesión en segundos (86400 = 24 horas)
JWT_EXPIRES_IN=86400

# ---- Archivos ----
UPLOAD_DIR=./uploads

# ---- Mapas (puntos de interés) ----
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ---- Seed del administrador (npm run db:seed) ----
ADMIN_EMAIL=admin@inmobisv.local
ADMIN_PASSWORD=CambiaEstaClave123
ADMIN_NAME=Administrador InmobiSV
